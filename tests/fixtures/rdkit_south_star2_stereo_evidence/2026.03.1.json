  "tree_bound_formula": "sum_r[d(r)! product(v!=r)(degree(v)-1)!] = 2|E| product_v(degree(v)-1)!",
  "source_claims": [
    {
      "path": "Code/GraphMol/Atom.cpp",
      "lines": "748-760",
      "claim": "Atom::getPerturbationOrder compares the proposed bond-index order with the atom incoming-bond reference frame."
    },
    {
      "path": "Code/GraphMol/Canon/Canon.cpp",
      "lines": "338-345, 1460-1508",
      "claim": "RDKit identifies when a tetrahedral tag needs inversion and computes parity from the traversal bond order, including implicit neighbors and the atom incoming-bond frame."
    },
    {
      "path": "Code/GraphMol/Canon/Canon.cpp",
      "lines": "356-417, 556-563",
      "claim": "RDKit chooses controlling directional carrier bonds by traversal order and assigns direction marks to encode configured double-bond stereo."
    },
    {
      "path": "Code/GraphMol/Canon/Canon.cpp",
      "lines": "1198-1304",
      "claim": "During directional stereo rendering, RDKit can set direction marks on a bond around a configured stereogenic double bond; seeded replay demonstrates that this can assign stereo to an otherwise unspecified middle double bond on parse-back."
    },
    {
      "path": "Code/GraphMol/Canon/Canon.cpp",
      "lines": "841-965, 991-1025, 1033-1124, 1146-1154",
      "claim": "The first depth-first traversal identifies ring closures, which are absent on these trees. The second traversal controls writer order. Together with traversal-based tetrahedral and directional rendering, each fixed root and child-order schedule yields one deterministic stereo spelling."
    },
    {
      "path": "Code/GraphMol/Canon/Canon.cpp",
      "lines": "840-965, 1033-1124, 1146-1154",
      "claim": "On this tree the cycle-detection DFS has no closures. The writer DFS selects a root and child order, and records each continuation or branch in that order."
    },
    {
      "path": "Code/GraphMol/Canon/Canon.cpp",
      "lines": "376-419, 450-477",
      "claim": "RDKit orders the double-bond endpoints by atom visit order, selects the lowest-visit-order eligible carrier on each end, and derives carrier flips from traversal order."
    },
    {
      "path": "Code/GraphMol/Canon/Canon.cpp",
      "lines": "92-145, 553-563",
      "claim": "For E stereo RDKit takes the controlling carrier sign as reference and derives the other carrier sign from traversal flips; when neither side has a direction, the first controlling carrier is assigned ENDUPRIGHT."
    },
    {
      "path": "Code/GraphMol/Canon/Canon.cpp",
      "lines": "1312-1344",
      "claim": "The final redundancy pass clears only unneeded direction marks; the two marks needed for the configured E bond remain on its carriers."
    },
    {
      "path": "Code/GraphMol/SmilesParse/SmilesWrite.cpp",
      "lines": "279-292",
      "claim": "RDKit renders ENDUPRIGHT as slash and ENDDOWNRIGHT as backslash in isomeric SMILES."
    }
  ],
